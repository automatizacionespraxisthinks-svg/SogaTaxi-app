<?xml version="1.0" encoding="utf-8"?>
<!-- FASE 0: la API de desarrollo corre por HTTP en la red local (por ejemplo
     http://192.168.1.3:3000). En producción la API va por HTTPS y esto se
     quita: cleartextTrafficPermitted debe volver a false. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
